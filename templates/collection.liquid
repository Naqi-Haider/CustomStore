<section class="collection-page">
  <div class="collection-container">
    {% comment %}
      <!-- Collection Header -->
      <header class="collection-header">
        <h1 class="collection-title">Toyota Cars</h1>

        <p class="collection-description">
          Explore our collection of Toyota cars. Find the perfect vehicle that matches your style, needs, and budget.
        </p>

        <p class="collection-count">12 products</p>
      </header>
    {% endcomment %}

    <!-- Collection Toolbar -->
    <div class="collection-toolbar">
      <button class="filter-toggle">Filters</button>

      <div class="collection-sort">
        <label for="sort-by"> Sort by: </label>

        <select id="sort-by">
          <option value="featured">Featured</option>

          <option value="price-low">Price: Low to High</option>

          <option value="price-high">Price: High to Low</option>

          <option value="newest">Newest</option>
        </select>
      </div>
    </div>

    <!-- Collection Content -->
    <div class="collection-content">
      <!-- Filters -->
      <aside class="collection-filters">
        <div class="filter-group">
          <h3>Brand</h3>

          <label>
            <input type="checkbox">
            Toyota
          </label>

          <label>
            <input type="checkbox">
            Honda
          </label>

          <label>
            <input type="checkbox">
            BMW
          </label>

          <label>
            <input type="checkbox">
            Mercedes
          </label>
        </div>

        <div class="filter-group">
          <h3>Price</h3>

          <label>
            <input type="checkbox">
            Under PKR 5,000,000
          </label>

          <label>
            <input type="checkbox">
            PKR 5,000,000 - 10,000,000
          </label>

          <label>
            <input type="checkbox">
            Over PKR 10,000,000
          </label>
        </div>

        <div class="filter-group">
          <h3>Transmission</h3>

          <label>
            <input type="checkbox">
            Automatic
          </label>

          <label>
            <input type="checkbox">
            Manual
          </label>
        </div>
      </aside>

      <!-- Products -->
      {% paginate collection.products by 6 %}
        <div class="collection-products">
          {% for collection_product in collection.products %}
            <article class="car-card">
              <a href="{{ collection_product.url }}" class="car-image-wrapper">
                <img
                  src="{{ collection_product.featured_image | img_url: '800x600' }}"
                  alt="{{ collection_product.title }}"
                  class="car-image"
                  width="250"
                  height="200"
                >
              </a>
              <div class="car-info">
                {% comment %} <span class="car-brand"> Toyota </span>     {% endcomment %}
                <h2 class="car-title">{{ collection_product.title }}</h2>
                {% comment %} <p class="car-variant">{{ collection_product.first_available_variant }}</p> {% endcomment %}
                <div class="car-bottom">
                  <span class="car-price">{{ collection_product.price | money_with_currency }}</span>
                  <a href="#" class="car-button"> View Details </a>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
        <div class="pagination">
          {{ paginate | default_pagination }}
        </div>
      {% endpaginate %}
    </div>
  </div>
</section>

<style>
  /* =========================
   COLLECTION PAGE
    ========================= */

  .collection-page {
    width: 100%;
    padding: 60px 20px;
    background: #ffffff;
  }

  .collection-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* =========================
   COLLECTION HEADER
    ====================== */

  .collection-header {
    text-align: center;
    margin-bottom: 45px;
  }

  .collection-title {
    margin: 0 0 15px;
    font-size: 42px;
    line-height: 1.2;
    font-weight: 700;
  }

  .collection-description {
    max-width: 700px;
    margin: 0 auto 15px;
    color: #666;
    font-size: 16px;
    line-height: 1.6;
  }

  .collection-count {
    margin: 0;
    color: #888;
    font-size: 14px;
  }

  /* =========================
   TOOLBAR
    ========================= */

  .collection-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 15px 0;
    margin-bottom: 30px;

    border-top: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
  }

  .filter-toggle {
    display: none;

    padding: 10px 18px;

    border: 1px solid #222;
    background: #ffffff;

    font-size: 14px;
    cursor: pointer;
  }

  .collection-sort {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  .collection-sort label {
    font-size: 14px;
    color: #555;
  }

  .collection-sort select {
    min-width: 180px;

    padding: 10px 35px 10px 12px;

    border: 1px solid #d5d5d5;
    background: #ffffff;

    font-size: 14px;
    cursor: pointer;
  }

  /* =========================
   COLLECTION CONTENT
    ========================= */

  .collection-content {
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: 40px;
  }

  /* =========================
   FILTERS
    ========================= */

  .collection-filters {
    border-right: 1px solid #e5e5e5;
    padding-right: 30px;
  }

  .filter-group {
    padding-bottom: 25px;
    margin-bottom: 25px;

    border-bottom: 1px solid #e5e5e5;
  }

  .filter-group:last-child {
    border-bottom: none;
  }

  .filter-group h3 {
    margin: 0 0 15px;

    font-size: 16px;
    font-weight: 600;
  }

  .filter-group label {
    display: flex;
    align-items: center;

    gap: 10px;

    margin-bottom: 12px;

    color: #555;
    font-size: 14px;

    cursor: pointer;
  }

  .filter-group input {
    width: 16px;
    height: 16px;

    cursor: pointer;
  }

  /* =========================
   PRODUCT GRID
    ========================= */

  .collection-products {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 35px 20px;
  }

  /* =========================
   CAR CARD
    ===================== */

  .car-card {
    min-width: 0;
  }

  .car-image-wrapper {
    display: block;

    width: 100%;
    aspect-ratio: 4 / 3;

    overflow: hidden;

    background: #f5f5f5;
  }

  .car-image {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: fill;

    transition: transform 0.35s ease;
  }

  .car-image-wrapper:hover .car-image {
    transform: scale(1.04);
  }

  /* =========================
   CAR INFORMATION
    ========================= */

  .car-info {
    padding-top: 15px;
  }

  .car-brand {
    display: block;

    margin-bottom: 5px;

    color: #888;

    font-size: 12px;
    font-weight: 600;

    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .car-title {
    margin: 0 0 6px;

    font-size: 19px;
    line-height: 1.3;
    font-weight: 600;
  }

  .car-variant {
    margin: 0 0 15px;

    color: #777;

    font-size: 14px;
  }

  /* =========================
   PRICE + BUTTON
    ===================== */

  .car-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 15px;
  }

  .car-price {
    font-size: 16px;
    font-weight: 600;
  }

  .car-button {
    display: inline-block;

    padding: 9px 14px;

    background: #111;
    color: #ffffff;

    text-decoration: none;

    font-size: 13px;
    font-weight: 500;

    transition: background 0.2s ease, transform 0.2s ease;
  }

  .car-button:hover {
    background: #333;
    transform: translateY(-1px);
  }

  /* =========================
   TABLET
    ===================== */

  @media (max-width: 1000px) {
    .collection-content {
      grid-template-columns: 200px 1fr;
      gap: 25px;
    }

    .collection-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* =========================
   MOBILE
    ========================= */

  @media (max-width: 700px) {
    .collection-page {
      padding: 40px 15px;
    }

    .collection-title {
      font-size: 32px;
    }

    .collection-description {
      font-size: 14px;
    }

    .collection-toolbar {
      margin-bottom: 20px;
    }

    .filter-toggle {
      display: block;
    }

    .collection-content {
      display: block;
    }

    .collection-filters {
      display: none;
    }

    .collection-sort {
      margin-left: 0;
    }

    .collection-sort label {
      display: none;
    }

    .collection-sort select {
      min-width: 150px;
    }

    .collection-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 30px 12px;
    }

    .car-info {
      padding-top: 10px;
    }

    .car-title {
      font-size: 16px;
    }

    .car-price {
      font-size: 14px;
    }

    .car-button {
      padding: 8px 10px;
      font-size: 12px;
    }
  }

  /* =========================
   SMALL MOBILE
    ========================= */

  @media (max-width: 450px) {
    .collection-products {
      grid-template-columns: 1fr;
    }

    .car-title {
      font-size: 18px;
    }

    .car-price {
      font-size: 15px;
    }
  }

  /* =========================
   PAGINATION
========================= */

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: row nowrap;

    margin-top: 50px;
    padding-top: 25px;

    border-top: 1px solid #e5e5e5;
  }

  .pagination .page,
  .pagination .next,
  .pagination .prev {
    display: inline-flex;
    justify-content: center;
    align-items: center;

    min-width: 40px;
    height: 40px;

    margin: 0 4px;

    border: 1px solid #ddd;
    background: #fff;

    color: #222;

    text-decoration: none;
    font-size: 14px;

    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  /* Hover */

  .pagination .page:hover,
  .pagination .next:hover,
  .pagination .prev:hover {
    background: #111;
    border-color: #111;
    color: #fff;
  }

  /* Current Page */

  .pagination .page.current {
    background: #111;
    border-color: #111;
    color: #fff;

    font-weight: 600;
  }

  /* Disabled Previous / Next */

  .pagination .prev.disabled,
  .pagination .next.disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* =========================
   MOBILE
========================= */

  @media (max-width: 600px) {
    .pagination {
      margin-top: 35px;
      padding-top: 20px;
    }

    .pagination .page,
    .pagination .next,
    .pagination .prev {
      min-width: 36px;
      height: 36px;

      margin: 0 2px;

      font-size: 13px;
    }
  }
</style>
