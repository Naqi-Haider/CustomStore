{{ 'splide.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'splide.min.js' | asset_url }}" defer></script>

<section class="product-page">
  <div class="product-page__container">
    {% comment %} <p> {{ product.featured_image.width }} * {{ product.featured_image.height }}</p> {% endcomment %}

    <!-- LEFT: Product Gallery -->
    <div class="product-gallery">
      <!-- Main Image -->
      {% comment %}
        <div class="product-gallery__main">
          {% if product.featured_image %}
            <img
              id="ProductMainImage"
              src="{{ product.featured_image | image_url: width: 1200 }}"
              srcset="
                {{ product.featured_image | image_url: width: 400 }} 600w,
                {{ product.featured_image | image_url: width: 800 }} 900w,
                {{ product.featured_image | image_url: width: 1200 }} 1200w
              "

              sizes="(max-width: 900px) 100vw, 60vw"
              alt="{{ product.featured_image.alt | escape }}"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              loading="eager"
            >
          {% endif %}
        </div>
      {% endcomment %}

      <!-- MAIN IMAGE CAROUSEL -->
      <section
        id="main-carousel"
        class="splide"
        aria-label="Product images"
      >
        <div class="splide__track">
          <ul class="splide__list">
            {% for media in product.media %}
              <li class="splide__slide">
                {% if media.media_type == 'image' %}
                  <img
                    src="{{ media.preview_image | image_url: width: 1200 }}"
                    srcset="
                      {{ media.preview_image | image_url: width: 400 }} 400w,
                      {{ media.preview_image | image_url: width: 800 }} 800w,
                      {{ media.preview_image | image_url: width: 1200 }} 1200w
                    "
                    sizes="(max-width: 900px) 100vw, 60vw"
                    alt="{{ media.alt | escape }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    width="{{ media.preview_image.width }}"
                    height="{{ media.preview_image.height }}"
                  >
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
      </section>

      <!-- THUMBNAILS -->
      <section
        id="thumbnail-carousel"
        class="splide"
        aria-label="Product thumbnails"
      >
        <div class="splide__track">
          <ul class="splide__list">
            {% for media in product.media %}
              <li class="splide__slide">
                {% if media.media_type == 'image' %}
                  <button
                    type="button"
                    class="product-gallery__thumbnail"
                  >
                    <img
                      src="{{ media.preview_image | image_url: width: 200 }}"
                      alt="{{ media.alt | escape }}"
                      width="100"
                      height="100"
                    >
                  </button>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
      </section>

      <!-- Thumbnails -->
      {% comment %}
        <div class="product-gallery__thumbnails">

        </div>
      {% endcomment %}
    </div>

    <!-- RIGHT: Product Information -->
    <div class="product-info">
      <!-- Product Title -->
      <h1 class="product-info__title">
        {{ product.title }}
      </h1>

      <!-- Product Price -->
      <div class="product-info__price" id="product-price">
        {{ product.selected_or_first_available_variant.price | money_with_currency }}
      </div>

      {% form 'product', product, class: 'product-form' %}
        <!-- Variant Selector -->
        {% unless product.has_only_default_variant %}
          <div class="product-form__variants">
            {% for option in product.options_with_values %}
              <div class="product-form__option">
                <label
                  for="Option-{{ product.id }}-{{ forloop.index }}"
                  class="product-form__label"
                >
                  {{ option.name }}
                </label>

                <select
                  id="Option-{{ product.id }}-{{ forloop.index }}"
                  class="product-form__select"
                  name="options[{{ option.name | escape }}]"
                >
                  {% for value in option.values %}
                    <option value="{{ value | escape }}">
                      {{ value }}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% endfor %}
          </div>
        {% endunless %}

        <!-- Quantity -->

        {% render 'quantity' %}

        <!-- Variant ID -->

        <input
          type="hidden"
          id="selected-variant-id"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
        >

        <!-- Add To Cart -->

        <button
          type="submit"
          name="add"
          class="product-form__submit"
          {% unless product.available %}
            disabled
          {% endunless %}
        >
          {% if product.available %}
            Add to cart
          {% else %}
            Sold out
          {% endif %}
        </button>
      {% endform %}
    </div>
  </div>
</section>

{% comment %}
  To get the formdata of the add to cart form, we are using the snippet from
  the Cart API documentation: https://shopify.dev/docs/api/ajax/reference/cart#add-2020-07

  From there, it is possible to get the formdata of the add to cart form and send it to the cart/add.js endpoint using fetch.
  This will add the product to the cart without reloading the page.

  After this we are gonna reference the cart-drawer snippet and update the cart count and items in the cart drawer.
{% endcomment %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const addToCartForm = document.querySelector('form[action$="/cart/add"]');

    if (!addToCartForm) return;

    addToCartForm.addEventListener('submit', async (e) => {
      // 1. Stop the page from reloading/redirecting to /cart
      e.preventDefault();

      // 2. Capture fresh form values at the exact moment of click
      const formData = new FormData(addToCartForm);

      // 3. Add the 'sections' parameter to the form data to specify which sections to update after adding the product to the cart
      formData.append('sections', 'cart-drawer');

      try {
        const response = await fetch((window.Shopify?.routes?.root || '/') + 'cart/add.js', {
          method: 'POST',
          body: formData,
        });

        if (!response.ok) {
          throw new Error(`Cart add failed: ${response.statusText}`);
        }

        const addedItem = await response.json();

        //Get the real cart state:
        const cartResponse = await fetch((window.Shopify?.routes?.root || '/') + 'cart.js');
        const cart = await cartResponse.json();
        const count = cart.item_count;

        const newDrawer = addedItem.sections['cart-drawer'];

        if (newDrawer) {

          const parser = new DOMParser();
          const dom = parser.parseFromString(newDrawer, 'text/html');

          const newContent = dom.querySelector('#cart-drawer-content');
          const currentContent = document.getElementById('cart-drawer-content');

          if(newContent && currentContent) {
            currentContent.innerHTML = newContent.innerHTML;
          }

          const newCartCount = dom.querySelector('#cart-count');
          const currentCartCount = document.querySelector('#cart-count');

          {% comment %} const newCartLabel = dom.querySelector('.cart-btn-label'); {% endcomment %}
          const currentCartLabel = document.querySelector('.cart-btn-label');

          if (newCartCount && currentCartCount) {
            currentCartCount.textContent = newCartCount.textContent;
          }

          if (newCartCount && currentCartLabel) {
              const count = Number(newCartCount.textContent.trim());

              currentCartLabel.textContent =
                  count === 0 ? 'Empty Cart' : 'View Cart';
          }

          {% comment %} document.getElementById('cart-count').textContent = count;
          document.querySelector('.cart-btn-label').textContent = count > 0 ? 'View Cart' : 'Empty Cart'; {% endcomment %}
          
          {% comment %} const count = parseInt(dom.querySelector('#cart-count')?.textContent || '0',10);
          const buttonLabel = document.querySelector('.cart-btn-label');
          console.log('Count:', count);
          console.log('Button Label:', buttonLabel);
          if(buttonLabel && count > 0) {
            buttonLabel.textContent = 'View Cart';
          }
          
          selectors.forEach((selector) => {
            const currentTarget = document.querySelector(selector);
            const newTarget = dom.querySelector(selector);

            if (currentTarget && newTarget) {
              currentTarget.innerHTML = newTarget.innerHTML;
            }
          }); {% endcomment %}


          {% comment %} //For the count cart:
          const cartRes = await fetch((window.Shopify?.routes?.root || '/') + 'cart.js');
          const cartData = await cartRes.json();
          const newCount = cartData.item_count;

          document.querySelectorAll('#cart-count, .header-count').forEach((el) => {
            el.textContent = newCount;
          });

          const cartBtn = document.getElementById('cart-btn');
          if (cartBtn && newCount > 0) {
            cartBtn.innerHTML = `View Cart (<span id="cart-count">${newCount}</span>)`;
          }

          //For the Subtotal in the cart drawer:
          const existingSubtotal = document.querySelector('#cart-total') || document.querySelector('.subtotal-amount');
          const newSubtotal = document.querySelector('#cart-total');

          if (existingSubtotal > 0) {
            existingSubtotal.innerHTML = newSubtotal.innerHTML;
          }

          //For the items in the cart drawer:
          const parser = new DOMParser();
          const dom = parser.parseFromString(newDrawer, 'text/html');
          console.log(dom);

          const currentItems = document.querySelector('#items') || document.querySelector('.drawer-body');
          const newItems = dom.querySelector('#items');

          if (currentItems && newItems) {
            currentItems.innerHTML = newItems.innerHTML;
          } {% endcomment %}
        }

        // 3. Dispatch event with item details in the detail payload
        document.dispatchEvent(
          new CustomEvent('product:added', {
            detail: {
              item: addedItem,
              sections: addedItem.sections,
            },
          })
        );
      } catch (error) {
        console.error('Error adding item to cart:', error);
      }
    });
  });
</script>

<script>
  const variants = {{ product.variants | json }};

  document.querySelectorAll('.product-form__select').forEach((select) => {
    select.addEventListener('change', (e) => {
      console.log(e.target.value);
      updateVariant();
    });
  });

  
  document.addEventListener("DOMContentLoaded", ()=> {
    updateVariant();
  })
  
  async function updateVariant() {
    try {
      const selectedVariant = Array.from(document.querySelectorAll('.product-form__select')).map((select) => select.value);
      console.log('SelectedVariant: ', selectedVariant);

      const variant = variants.find((variant) => {
        return variant.options.every((option, index) => {
          return option === selectedVariant[index];
        })
      })

      if(!variant){
        console.log("No variant matching found");
        return;
      }

      const variantInputId = document.getElementById('selected-variant-id');
      if(variantInputId){
        variantInputId.value = variant.id;
      }
      

      const url = `{{ product.url }}?variant=${variant.id}&section_id=updated-variant`;
      const response = await fetch(url);

      if(!response){
        throw new Error(`Request failed: ${response.status}`);
      }


      {% comment %} const response = await fetch(url);
      const sections = await response.json(); {% endcomment %}

      const html = await response.text();
      if(!html){
        throw new Error('Updated variant section was not returned');
      }

      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');

      const newPrice = doc.querySelector('#updated-variant-price');
      const currentPrice = document.getElementById('product-price');

      if (newPrice && currentPrice) {
        currentPrice.innerHTML = newPrice.innerHTML;
      }
    } catch (error) {
      console.log('Error found in variant Updated', error);
    }
  }
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const main = new Splide('#main-carousel', {
      type: 'slide',
      height: '680px',
      pagination: false,
      arrows: true,
      cover: false,
    });

    const thumbnails = new Splide('#thumbnail-carousel', {
      fixedWidth: 100,
      fixedHeight: 80,
      gap: 12,
      rewind: true,
      pagination: false,
      arrows: false,
      isNavigation: true,
      focus: 'center',
      cover: false,
    });

    main.sync(thumbnails);

    main.mount();
    thumbnails.mount();
  });
</script>

<style>
  /* =========================================
    PRODUCT PAGE
    ========================================= */

  .product-page {
    width: 100%;
    padding: 60px 20px;
  }

  .product-page__container {
    max-width: 1200px;
    margin: 0 auto;

    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(350px, 0.8fr);
    gap: 70px;

    align-items: start;
  }

  /* =========================================
    PRODUCT GALLERY
    ========================================= */

  .product-gallery {
    width: 100%;
    max-width: 900px;
  }

  /* Main carousel */

  #main-carousel {
    width: 100%;
  }

  #main-carousel .splide__slide {
    height: 680px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #main-carousel .splide__slide img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
  }

  /* =========================================
   THUMBNAIL CAROUSEL
   ========================================= */

  #thumbnail-carousel {
    width: 100%;
    margin-top: 20px;
  }

  /* Splide slide = spacing only, NO BORDER */
  #thumbnail-carousel .splide__slide {
    width: 100px;
    height: 80px;
    opacity: 0.65;

    border: none;
    background: transparent;

    transition: opacity 0.2s ease;
  }

  /* Active slide */
  #thumbnail-carousel .splide__slide.is-active {
    opacity: 1;
  }

  /* =========================================
   THUMBNAIL BUTTON
   ========================================= */

  .product-gallery__thumbnail {
    width: 100%;
    height: 100%;

    padding: 5px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #fff;

    /* SINGLE SOLID BORDER */
    border: 2px solid #d0d0d0;
    border-radius: 8px;

    box-sizing: border-box;

    overflow: hidden;
    cursor: pointer;

    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  /* Image */
  .product-gallery__thumbnail img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  /* Active thumbnail */
  #thumbnail-carousel .splide__slide.is-active .product-gallery__thumbnail {
    border-color: #111;
    box-shadow: 0 0 0 1px #111;
  }

  /* Hover */
  .product-gallery__thumbnail:hover {
    border-color: #777;
  }

  /* =========================================
    PRODUCT INFORMATION
    ========================================= */

  .product-info {
    width: 100%;

    position: sticky;
    top: 30px;
  }

  .product-info__title {
    margin: 0 0 18px;

    font-size: 36px;
    line-height: 1.15;
    font-weight: 600;

    color: #111;
  }

  .product-info__price {
    margin-bottom: 35px;

    font-size: 24px;
    font-weight: 500;

    color: #111;
  }

  /* =========================================
    PRODUCT FORM
    ========================================= */

  .product-form {
    width: 100%;
  }

  .product-form__variants {
    display: flex;
    flex-direction: column;
    gap: 20px;

    margin-bottom: 25px;
  }

  .product-form__option {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .product-form__label {
    font-size: 14px;
    font-weight: 600;

    color: #111;
  }

  .product-form__select {
    width: 100%;

    padding: 14px 15px;

    border: 1px solid #ccc;
    border-radius: 6px;

    background: #fff;

    font-size: 15px;

    cursor: pointer;
  }

  /* =========================================
    QUANTITY
    ========================================= */

  {% comment %} .product-form__quantity {
    display: flex;
    flex-direction: column;
    gap: 8px;

    margin-bottom: 25px;
  }

  .product-form__quantity input {
    width: 100px;

    padding: 13px;

    border: 1px solid #ccc;
    border-radius: 6px;

    font-size: 16px;

    text-align: center;
  } {% endcomment %}

  /* =========================================
    ADD TO CART
    ========================================= */

  .product-form__submit {
    width: 100%;

    padding: 17px 25px;

    border: none;
    border-radius: 6px;

    background: #111;
    color: #fff;

    font-size: 16px;
    font-weight: 600;

    cursor: pointer;

    transition: background 0.2s ease, transform 0.2s ease;
  }

  .product-form__submit:hover {
    background: #333;
  }

  .product-form__submit:active {
    transform: scale(0.99);
  }

  .product-form__submit:disabled {
    background: #ccc;
    color: #666;
    cursor: not-allowed;
  }

  /* =========================================
    TABLET
    ========================================= */

  @media screen and (max-width: 900px) {
    .product-page__container {
      grid-template-columns: 1fr;

      gap: 40px;
    }

    .product-info {
      position: static;
    }

    .product-info__title {
      font-size: 30px;
    }
  }

  /* =========================================
    MOBILE
    ========================================= */

  @media screen and (max-width: 600px) {
    .product-page {
      padding: 30px 15px;
    }

    .product-page__container {
      gap: 30px;
    }

    .product-info__title {
      font-size: 26px;
    }

    .product-info__price {
      font-size: 21px;
    }
  }
</style>
