<header class="site-header">
  <div class="header-container">
    <!-- Logo -->
    <div class="header-logo">
      <a href="{{ routes.root_url }}" class="logo-link">
        {% if settings.logo %}
          {{ settings.logo | image_url: width: 250 | image_tag: class: 'logo-image', alt: shop.name }}
        {% else %}
          <span class="logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Navigation -->
    <nav class="main-nav" aria-label="Main navigation">
      <ul class="nav-list">
        {% for link in section.settings.header_nav.links %}
          <li class="nav-item {% if link.handle == 'catalog' %}has-mega-menu{% endif %}">
            <a class="{% if link.active %}active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
            {% for block in section.blocks %}
              {% if block.settings.handle == link.handle %}
                {% render 'mega-menu', block: block %}
              {% endif %}
            {% endfor %}
            {% comment %} 
             Instead of hardcoding we will use the block settings to render the mega menu for the catalog link.
             {% if link.handle == 'catalog' %}
              {% render 'mega-menu' %}
            {% endif %} {% endcomment %}
          </li>
        {% endfor %}

        {% comment %}
          <li class="nav-item">
            <a href="{{ routes.root_url }}" class="nav-link"> Home </a>
          </li>

          <li class="nav-item">
            <a href="/collections/all" class="nav-link"> Cars </a>
          </li>

          <li class="nav-item">
            <a href="/collections/toyota" class="nav-link"> Toyota </a>
          </li>

          <li class="nav-item">
            <a href="/collections/honda" class="nav-link"> Honda </a>
          </li>

          <li class="nav-item">
            <a href="/pages/about-us" class="nav-link"> About </a>
          </li>

          <li class="nav-item">
            <a href="/pages/contact" class="nav-link"> Contact </a>
          </li>
        {% endcomment %}
      </ul>
    </nav>

    <!-- Cart -->
    <div class="header-actions">
      <a
        id="cart-btn"
        href="{{ routes.cart_url }}"
        class="cart-button"
        aria-label="Cart"
      >
        <!-- Cart Icon -->
        <svg
          class="cart-icon"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M3 4H5L7.2 14.2C7.4 15.1 8.2 15.7 9.1 15.7H17.4C18.3 15.7 19.1 15.1 19.3 14.2L21 7H6"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <circle
            cx="9.5"
            cy="19"
            r="1.4"
            fill="currentColor"
          />

          <circle
            cx="17"
            cy="19"
            r="1.4"
            fill="currentColor"
          />
        </svg>

        <!-- Cart Count -->
        <span
          class="cart-count"
          id="cart-count"
        >
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Navbar",
  "settings": [
    {
      "type": "link_list",
      "id": "header_nav",
      "label": "Header navigation"
    }
  ],
  "blocks": [
    {
        "type": "mega_menu",
        "name": "Mega Menu",
        "settings": [
            {
                "type": "text",
                "id": "handle",
                "label": "Mega Menu Handle"
            },
            {
                "type": "link_list",
                "id": "mega_1",
                "label": "Menu 1"

            },
            {
                "type": "link_list",
                "id": "mega_2",
                "label": "Menu 2"

            },
            {
                "type": "image_picker",
                "id": "mega_image",
                "label": "Image"
            },
            {
                "type": "url",
                "id": "mega_image_url",
                "label": "Image url"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Navbar"
    }
  ]
}
{% endschema %}

<style>
  /* =========================
   HEADER
    ========================= */

  .site-header {
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #e5e5e5;
    position: relative;
    z-index: 100;
  }

  .header-container {
    max-width: 1400px;
    height: 82px;
    margin: 0 auto;
    padding: 0 40px;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* =========================
   LOGO
    ========================= */

  .header-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: #111111;
  }

  .logo-image {
    display: block;
    width: auto;
    max-width: 180px;
    max-height: 55px;
    object-fit: contain;
  }

  .logo-text {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  /* =========================
   NAVIGATION
    ========================= */

  .main-nav {
    display: flex;
    align-items: center;
    margin-left: auto;
    margin-right: 55px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 38px;

    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    list-style: none;
    margin: 0;
    padding: 0;
    color: black;
  }

  .nav-item a {
    display: block;
    padding: 10px 15px;
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }

  .nav-item a:hover {
    color: #777;
  }

  .nav-link {
    position: relative;

    display: inline-block;
    padding: 8px 0;

    color: #222222;
    text-decoration: none;

    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.2px;

    transition: color 0.25s ease;
  }

  /* Underline animation */

  .nav-link::after {
    content: '';

    position: absolute;
    left: 0;
    bottom: 0;

    width: 0;
    height: 2px;

    background: #111111;

    transition: width 0.25s ease;
  }

  .nav-link:hover {
    color: #000000;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* =========================
   CART
    ========================= */

  .header-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .cart-button {
    position: relative;

    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #111111;
    text-decoration: none;

    border-radius: 50%;

    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .cart-button:hover {
    background-color: #f4f4f4;
  }

  .cart-button:active {
    transform: scale(0.95);
  }

  /* Cart SVG */

  .cart-icon {
    width: 25px;
    height: 25px;

    display: block;
  }

  /* =========================
   CART COUNT
    ======================== */

  .cart-count {
    position: absolute;

    top: 2px;
    right: 1px;

    min-width: 19px;
    height: 19px;

    padding: 0 5px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #111111;
    color: #ffffff;

    border-radius: 50%;

    font-size: 11px;
    font-weight: 600;
    line-height: 1;
  }

  /* =========================
   RESPONSIVE
    ========================= */

  @media screen and (max-width: 900px) {
    .header-container {
      height: 72px;
      padding: 0 25px;
    }

    .main-nav {
      margin-right: 25px;
    }

    .nav-list {
      gap: 22px;
    }

    .nav-link {
      font-size: 14px;
    }

    .logo-image {
      max-width: 150px;
    }
  }

  @media screen and (max-width: 700px) {
    .header-container {
      padding: 0 18px;
    }

    /*
     Hide navigation temporarily on mobile.
     You can replace this with a hamburger menu later.
  */

    .main-nav {
      display: none;
    }

    .logo-image {
      max-width: 140px;
      max-height: 48px;
    }

    .cart-button {
      width: 42px;
      height: 42px;
    }
  }
</style>
