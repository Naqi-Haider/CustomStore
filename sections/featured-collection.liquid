<section class="featured-collection">
  <div class="featured-collection__container">

    <div class="featured-collection__header">
      <h2>Featured Collection</h2>
      <p>Explore our most popular products.</p>
    </div>

    <div class="featured-collection__grid">

      <!-- Product 1 -->
      <article class="product-card">
        <div class="product-card__image">
          <img
            src="https://via.placeholder.com/400"
            alt="Product 1"
          >
        </div>

        <div class="product-card__info">
          <h3>Product One</h3>
          <p class="product-card__price">$49.99</p>
        </div>
      </article>

      <!-- Product 2 -->
      <article class="product-card">
        <div class="product-card__image">
          <img
            src="https://via.placeholder.com/400"
            alt="Product 2"
          >
        </div>

        <div class="product-card__info">
          <h3>Product Two</h3>
          <p class="product-card__price">$59.99</p>
        </div>
      </article>

      <!-- Product 3 -->
      <article class="product-card">
        <div class="product-card__image">
          <img
            src="https://via.placeholder.com/400"
            alt="Product 3"
          >
        </div>

        <div class="product-card__info">
          <h3>Product Three</h3>
          <p class="product-card__price">$39.99</p>
        </div>
      </article>

      <!-- Product 4 -->
      <article class="product-card">
        <div class="product-card__image">
          <img
            src="https://via.placeholder.com/400"
            alt="Product 4"
          >
        </div>

        <div class="product-card__info">
          <h3>Product Four</h3>
          <p class="product-card__price">$69.99</p>
        </div>
      </article>

    </div>

  </div>
</section>


{% schema %}
{
  "name": "Featured Collection",
  "settings": [],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}

<style>
    .featured-collection {
    padding: 60px 20px;
    }

    .featured-collection__container {
    max-width: 1200px;
    margin: 0 auto;
    }

    .featured-collection__header {
    text-align: center;
    margin-bottom: 40px;
    }

    .featured-collection__header h2 {
    margin: 0 0 10px;
    font-size: 32px;
    }

    .featured-collection__header p {
    margin: 0;
    color: #666;
    font-size: 16px;
    }

    .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    }

    /* Product Card */

    .product-card {
    min-width: 0;
    }

    .product-card__image {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f5f5f5;
    }

    .product-card__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    }

    .product-card__info {
    padding-top: 15px;
    }

    .product-card__info h3 {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 500;
    }

    .product-card__price {
    margin: 0;
    font-size: 15px;
    }

    /* Tablet */

    @media screen and (max-width: 990px) {
    .featured-collection__grid {
        grid-template-columns: repeat(2, 1fr);
    }
    }

    /* Mobile */

    @media screen and (max-width: 600px) {
    .featured-collection {
        padding: 40px 15px;
    }

    .featured-collection__header h2 {
        font-size: 26px;
    }

    .featured-collection__grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }
    }
</style>